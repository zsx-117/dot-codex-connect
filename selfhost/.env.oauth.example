# Inert template. No client registration, account or credentials are supplied.
DOT_AUTH_MODE=oauth
# Do NOT set DOT_MCP_TOKEN in OAuth mode.
DOT_DEVICE_TOKEN=REPLACE_WITH_OPERATOR_MANAGED_DEVICE_TOKEN
DOT_DATABASE=./state/bridge.sqlite
DOT_PORT=8787
DOT_OAUTH_RESOURCE=https://connect.example.invalid/mcp

DOT_OAUTH_SUBJECT=REPLACE_WITH_OPERATOR_SUBJECT
DOT_OAUTH_CLIENT_ID=REPLACE_WITH_APPROVED_CLIENT_ID
DOT_OAUTH_SCOPE=codex:bridge
